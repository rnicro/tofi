# Template file for 'tofi'
pkgname=tofi
version=0.9.1
revision=2
build_style=meson
configure_args="-Doptimization=2 -Db_lto=true"
hostmakedepends="scdoc pkg-config wayland-devel wayland-protocols"
makedepends="freetype-devel cairo-devel pango-devel wayland-devel
 libxkbcommon-devel harfbuzz-devel"
short_desc="Tiny dynamic menu for Wayland"
maintainer="rnicro <nocontact@nomail.org>"
license="MIT"
homepage="https://github.com/philj56/tofi"
changelog="https://raw.githubusercontent.com/philj56/tofi/master/CHANGELOG.md"
distfiles="https://github.com/philj56/tofi/archive/refs/tags/v${version}.tar.gz"
checksum=dd55347b509af786f133def64f3a86f1db258b5e196de80e53d62827bdcc37bc

# This binary is deliberately restricted to the reference CPU family and ABI.
archs="x86_64-musl"
lib32disabled=yes

# Build for Intel Skylake (including the Core i3-6100U), not the CI host CPU.
CFLAGS+=" -march=skylake -mtune=skylake"

# Void's tofi recipe requires the separate fts implementation on musl.
if [ "$XBPS_TARGET_LIBC" = musl ]; then
	makedepends+=" musl-fts-devel"
	LDFLAGS+=" -lfts"
fi

post_install() {
	vlicense LICENSE
}
